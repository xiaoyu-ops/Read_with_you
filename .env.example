# Copy to .env on the server and fill the keys you actually use.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
RELAY_API_KEY=
MINERU_API_TOKEN=

# Web paper block translation. DeepLX handles only plain translation; Pet,
# Agent analysis and tool use continue through the configured LiteLLM models.
PEINIDU_TRANSLATION_PROVIDER=deeplx
DEEPLX_API_KEY=
PEINIDU_RUNTIME_MODE=self_hosted
DEEPLX_API_BASE=https://api.deeplx.org
DEEPLX_TIMEOUT_SECONDS=30

# Public portal only. The portal never receives paper content or credentials.
# Release URLs must be HTTPS. Disable access logs at the edge/reverse proxy.
PEINIDU_PORTAL_DATA_DIR=
PEINIDU_RELEASE_MANIFEST=

# Local Core anonymous usage is opt-in and defaults off. Override only for
# development or a separately audited portal; plain HTTP is accepted only on
# loopback. The packaged default points at the official portal.
PEINIDU_TELEMETRY_ENDPOINT=https://readwithyou.xiaoyu666.cyou/api/portal/telemetry
PEINIDU_APP_VERSION=dev

# Optional translated-PDF sidecar. Keep disabled until the AGPL disclosure is
# published. Generate one independent random token; no provider key enters the
# sidecar container.
PEINIDU_PDF_EXPORT_INTERNAL_TOKEN=
PEINIDU_PDF_EXPORT_SIDECAR_URL=http://pdf-export:8090
PEINIDU_PDF_EXPORT_MAX_FILE_BYTES=52428800
PEINIDU_PDF_EXPORT_MAX_PAGES=200
PEINIDU_PDF_EXPORT_CONCURRENCY=1
PEINIDU_PDF_EXPORT_TIMEOUT_SECONDS=1800
# Mutating export endpoints have a dedicated per-client limit and a bounded
# global running+queued set in addition to the sidecar execution semaphore.
PEINIDU_PDF_EXPORT_RATE_LIMIT_PER_MINUTE=12
PEINIDU_PDF_EXPORT_MAX_ACTIVE_RUNS=2

# Protect /config and /config/models on public deployments.
# Leave blank only for local-only development.
PEINIDU_ADMIN_TOKEN=

# Public HTTP port exposed by docker compose.
PEINIDU_HTTP_PORT=8080

# Per-IP API rate limit for expensive endpoints. Set 0 to disable.
PEINIDU_RATE_LIMIT_PER_MINUTE=120

# Optional reverse-proxy IP/CIDR allowlist. The backend ignores forwarded
# client IP headers unless the direct socket peer matches this list.
PEINIDU_TRUSTED_PROXY_IPS=

# Pet chat LLM intent classification (1 = on, 0 = keyword rules only).
# Adds one cheap LLM call per Pet message; falls back to keyword rules on failure.
PEINIDU_LLM_INTENT=1

# Add your production origin when exposing the API directly.
PEINIDU_CORS_ORIGINS=http://localhost:8080
