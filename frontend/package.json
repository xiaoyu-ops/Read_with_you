{
  "name": "peinidu-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test:inline-reader": "node --test tests/inlineTranslationAudit.test.mjs tests/pdfAssetUrl.test.mjs tests/pdfBackground.test.mjs tests/pdfExport.test.mjs tests/pdfSelectionAudit.test.mjs tests/pdfTextSelection.test.mjs tests/pdfVirtualization.test.mjs tests/readerContext.test.mjs tests/readerEvidence.test.mjs tests/readerReducer.test.mjs tests/readerSession.test.mjs tests/sse.test.mjs tests/translationFit.test.mjs",
    "test:inline-reader:browser": "playwright test --config=playwright.inline-reader.config.ts",
    "test:agent-workspace": "node --test tests/agentWorkspace.test.mjs",
    "test:agent-workspace:browser": "playwright test --config=playwright.agent-workspace.config.ts",
    "test:literature-map": "node --test tests/literatureMap.test.mjs",
    "test:literature-map:browser": "playwright test --config=playwright.literature-map.config.ts",
    "test:local-library": "node --test tests/localPaperLibrary.test.mjs",
    "test:local-library:browser": "playwright test --config=playwright.local-library.config.ts",
    "test:settings": "node --test tests/settingsPage.test.mjs",
    "test:guide": "node --test tests/guidePage.test.mjs",
    "test:pdf-text-selection:browser": "playwright test --config=playwright.pdf-text-selection.config.ts",
    "test:translation-fit": "node --test tests/translationFit.test.mjs",
    "test:translation-fit:browser": "playwright test --config=playwright.translation-fit.config.ts"
  },
  "dependencies": {
    "katex": "^0.17.0",
    "next": "15.5.21",
    "next-themes": "^0.4.4",
